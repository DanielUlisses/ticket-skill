# Models the /ticket, /small-ticket and /implement-tickets workflows run on.
# Edit here, then re-run ./install.sh. See docs/agents/models.md.
: "${TICKET_IMPL_MODEL:=opus}"     # implementation + the /small-ticket plan-mode orchestrator
: "${TICKET_REVIEW_MODEL:=opus}"   # ticket-reviewer subagent
: "${TICKET_TEST_MODEL:=haiku}"    # ticket-tester subagent
