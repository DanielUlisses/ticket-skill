# Models the /ticket, /small-ticket and /implement-tickets workflows run on.
# Edit here, then re-run ./install.sh. See docs/agents/models.md for the roster
# and docs/adr/0002-model-tiers-and-agent-roster.md for why each role sits where it does.
#
# Every effort is one of: low, medium, high, xhigh, max. The launcher refuses
# anything else — Claude Code itself only warns and then runs at its own default,
# which would make a typo look like it worked.

# ---- the implementer: varies per ticket ---------------------------------------
# The launch question, the 4th positional and --effort override these per ticket;
# a ticket's **Suggested model:** / **Suggested effort:** lines are what that
# question pre-selects.
: "${TICKET_IMPL_MODEL:=opus}"     # ticket-implementer, and the /small-ticket plan-mode orchestrator
: "${TICKET_IMPL_EFFORT:=medium}"

# ---- the coordinator: /ticket and /implement-tickets launches only ------------
# The plan is already settled there, so the launched session dispatches, judges
# and reports; it writes no code. /small-ticket's orchestrator plans with the
# developer instead, so it runs on the implementer's model and effort above.
: "${TICKET_COORD_MODEL:=opus}"
: "${TICKET_COORD_EFFORT:=low}"

# ---- the board session: /implement-tickets, resident ------------------------
# Not launched by anything — the developer starts it, and /ticket's hand-off
# quotes these in the command it prints. It reads the board, merges on request,
# launches waves and relays messages: bookkeeping, not design. Haiku is the goal
# once the digest is scripted (ADR 0003); sonnet @ low is the safe default today.
: "${TICKET_BOARD_MODEL:=sonnet}"
: "${TICKET_BOARD_EFFORT:=low}"

# ---- fixed roles: the same for every ticket -----------------------------------
: "${TICKET_REVIEW_MODEL:=opus}"     # ticket-reviewer — independent of the implementer's model
: "${TICKET_REVIEW_EFFORT:=medium}"
: "${TICKET_TEST_MODEL:=haiku}"      # ticket-tester — one per check, fanned out
: "${TICKET_TEST_EFFORT:=low}"
: "${TICKET_SCOUT_MODEL:=haiku}"     # ticket-scout — read-only repo discovery, fanned out
: "${TICKET_SCOUT_EFFORT:=low}"
: "${TICKET_RESEARCH_MODEL:=haiku}"  # ticket-researcher — external docs/APIs; sonnet if answers come back thin
: "${TICKET_RESEARCH_EFFORT:=medium}"
: "${TICKET_CHECK_MODEL:=haiku}"     # ticket-criteria-checker — one acceptance criterion each, fanned out
: "${TICKET_CHECK_EFFORT:=low}"
